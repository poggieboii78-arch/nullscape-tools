{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nullscape-quicklink-turn",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUICKLINK_ROOMS",
        "class_name": "QuickLinkRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuickLinkRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "VISITOR_RATE_LIMITER",
      "namespace_id": "11001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "SERVICE_RATE_LIMITER",
      "namespace_id": "11002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RELAY_VISITOR_RATE_LIMITER",
      "namespace_id": "11003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "RELAY_SERVICE_RATE_LIMITER",
      "namespace_id": "11004",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
